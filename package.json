{
  "name": "@thgilciffart/pi-subagents",
  "version": "0.1.0",
  "description": "Named Pi subagents with persistent conversations and crash recovery",
  "type": "module",
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "recovery"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.4.x",
    "@earendil-works/pi-coding-agent": "1.4.x",
    "@earendil-works/pi-tui": "1.4.x",
    "typebox": "1.3.27",
    "@earendil-works/pi-agent-core": "1.4.x"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typebox": "1.3.27",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0",
    "@earendil-works/pi-agent-core": "1.4.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thgilciffart/pi-subagents.git"
  },
  "homepage": "https://github.com/thgilciffart/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/thgilciffart/pi-subagents/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "thgilciffart",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  }
